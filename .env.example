# Local engine. Configure the admin token before exposing publish controls
# beyond a trusted localhost session.
COURSE_ENGINE_DB=course-engine.sqlite3
COURSE_ENGINE_ADMIN_TOKEN=

# Optional course-compilation optimizer. The deterministic compiler does not
# require these. Keep real values in .env.local or the system keychain.
COMPILER_AI_BASE_URL=https://api.openai.com/v1
COMPILER_AI_API_KEY=
COMPILER_AI_MODEL=

# Optional learner-facing assistant. It cannot call compiler tools or reuse the
# compiler credential implicitly.
STUDY_AI_BASE_URL=https://api.openai.com/v1
STUDY_AI_API_KEY=
STUDY_AI_MODEL=

# Optional MinerU document parser. It extracts documents but never decides the
# curriculum structure.
MINERU_BASE_URL=http://127.0.0.1:8001
MINERU_API_KEY=
